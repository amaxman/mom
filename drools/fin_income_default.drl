package mom.service.drl;
import mom.entity.factory.finance.FinIncoming
import java.util.Date
import com.jeesite.common.lang.DateUtils
dialect  "java"

global FinIncoming finIncoming
//应收待抵帐款默认值
rule "fin_income_default"
    when
    then
    if (finIncoming==null) throw new Exception("应收待抵帐款对象不存在");
    if (!finIncoming.getIsNewRecord()) throw new Exception("仅仅允许创建状态赋值");
    finIncoming.setInInvoiceDate(new Date());
    finIncoming.setInDatePlan(DateUtils.addMonths(new Date(),1));
    finIncoming.setInExpDate(DateUtils.addMonths(new Date(),2));
    finIncoming.setInApplyYear(Integer.parseInt(DateUtils.getYear()));
    finIncoming.setInApplyMonth(Integer.parseInt(DateUtils.getMonth()));
    finIncoming.setInCate("1"); //帐款类别=应收账款
    finIncoming.setInType("1");//贸易类型=1:内销
    finIncoming.setConfirmed("N");//是否确认
    finIncoming.setCanceled("N");//是否作废

end
